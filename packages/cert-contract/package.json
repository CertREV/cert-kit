{
	"name": "@certrev/cert-contract",
	"version": "0.5.3",
	"description": "CertDeliveryEnvelope: detached-Ed25519-over-RFC-8785(JCS) signed certification credential. Signs structured facts, not rendered JSON-LD. The verify path is edge-runtime safe (WebCrypto, no node:crypto); the issuer sign path is on './signer'.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CertREV/cert-kit.git",
		"directory": "packages/cert-contract"
	},
	"homepage": "https://github.com/CertREV/cert-kit/tree/HEAD/packages/cert-contract#readme",
	"bugs": {
		"url": "https://github.com/CertREV/cert-kit/issues"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./signer": {
			"types": "./dist/signer.d.ts",
			"default": "./dist/signer.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/__tests__/**",
		"src/__tests__/vectors.json",
		"src/__tests__/kms-crossverify-fixture.json",
		"src/__tests__/php-crossverify-fixture.json",
		"schema",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"publishTargets": [
		"npmjs",
		"github-packages"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"canonicalize": "^3.0.0"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"keywords": [
		"certrev",
		"ed25519",
		"rfc8785",
		"jcs",
		"json-canonicalization",
		"signed-credential"
	],
	"license": "MIT"
}
